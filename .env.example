# ============================================================
#  .env cho MAY LAP TRINH (local, XAMPP)
#
#  Copy file nay thanh `.env` roi sua gia tri cho khop may minh:
#      copy .env.example .env
#
#  `.env` da nam trong .gitignore — KHONG commit no.
#  Muon cau hinh cho server that thi xem .env.production.example.
# ============================================================

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tanphat_php
DB_USER=root
# XAMPP moi cai thi root khong co mat khau -> de trong
DB_PASS=

# --- Ung dung ---
# true = in chi tiet loi SQL ra man hinh. Chi bat o may lap trinh.
APP_DEBUG=true

# Duong dan con neu dat trong htdocs. Vi du du an o htdocs\tan-phat va truy cap
# qua http://localhost:88/tan-phat/ thi dat "/tan-phat".
# Chay bang VirtualHost tro thang vao thu muc du an thi de "/".
APP_BASE_PATH=/tan-phat

# De TRONG thi tu suy ra tu HTTP_HOST + APP_BASE_PATH — chay dung o may local.
# Dat cung URL production roi mo bang localhost thi font se bi CORS chan.
# APP_URL=http://localhost:88/tan-phat

# --- Session / dang nhap ---
SESSION_COOKIE=tanphat_fw_session

# Thoi gian song cua file session (giay). Duoc ap vao gc_maxlifetime.
SESSION_LIFETIME=86400

# Bao nhieu phut KHONG thao tac thi bi dang xuat.
# Chi ap cho lan dang nhap KHONG tick "Ghi nho dang nhap"; co tick thi giu 30 ngay.
SESSION_IDLE_MINUTES=15

# true = cookie chi gui qua HTTPS. Local chay http nen phai la false,
# de true thi khong dang nhap duoc.
SESSION_SECURE=false

# Doi cho luu file session. De trong thi dung storage/sessions (ngoai public/).
# SESSION_PATH=C:/ProgramData/tanphat/sessions
