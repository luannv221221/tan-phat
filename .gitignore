# Credential — TUYET DOI khong commit
.env

# Session that cua nguoi dung.
# CHO MOI (tu Phase 0 H3) — session luu o day, ngoai public/
storage/sessions/*
!storage/sessions/.gitkeep

# CHO CU — giu lai de repo cu khong commit lai 16 file session da tung bi lo
public/logs/session/*
!public/logs/session/.gitkeep

# Log
public/logs/errors/*
!public/logs/errors/.gitkeep
public/logs/access/*
!public/logs/access/.gitkeep

# Backup truoc khi va Phase 0
_backup_truoc_phase0/

# He dieu hanh / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Composer — bo qua vendor NHUNG giu autoloader tu viet (khong co dep ngoai)
# de deploy bang git clone van chay duoc ma khong can `composer install`.
/vendor/*
!/vendor/autoload.php

# Ban dump DB va file cau hinh may dich khi deploy (nhay cam — khong commit)
/deploy/*.sql
/deploy/*.zip

# Uploads — file nguoi dung tai len (logo hang, anh phu tung). Giu thu muc, bo qua noi dung.
public/assets/uploads/brands/*
!public/assets/uploads/brands/.gitkeep
public/assets/uploads/parts/*
!public/assets/uploads/parts/.gitkeep
public/assets/uploads/news/*
!public/assets/uploads/news/.gitkeep
public/assets/uploads/projects/*
!public/assets/uploads/projects/.gitkeep
public/assets/uploads/galleries/*
!public/assets/uploads/galleries/.gitkeep
public/assets/uploads/settings/*
!public/assets/uploads/settings/.gitkeep
public/assets/uploads/banners/*
!public/assets/uploads/banners/.gitkeep
public/assets/uploads/categories/*
!public/assets/uploads/categories/.gitkeep

# NGOAI LE cho anh minh hoa tai bang tools/tai-anh-commons.php.
#
# Luat o tren chan uploads la dung: do khach tu tai len thi khong thuoc ve ma
# nguon. Nhung mAY anh danh muc + bang-ron nay la DU LIEU MAU cua do an, sinh
# ra mot lan roi CSDL tro thang vao duong dan do. Khong cho di theo repo thi
# clone ve may khac (hoac luc bao ve) la ca trang tro anh vo, ma chay lai
# script cung khong ra dung may tam cu — ket qua tim kiem cua Commons doi
# theo tung luot goi.
!public/assets/uploads/categories/*.jpg
!public/assets/uploads/banners/bn-*.jpg
